---
import roomRoutes from '../../../data/room-routes.json';
import overlay from '../../../data/room-map-overlay.json';
import { formatRoomLabel, sortRoomsByFloor } from '../../lib/rooms.mjs';

export function getStaticPaths() {
	return roomRoutes.rooms.map((room) => ({ params: { room: room.id } }));
}

const { room: roomId } = Astro.params;
const meta = roomRoutes.rooms.find((r) => r.id === roomId);
if (!meta) throw new Error(`Unknown room: ${roomId}`);

const title = formatRoomLabel(meta.id, meta.name);
const assembly = roomRoutes.meta.assemblyDefault ?? 'South parking lot';
const assemblySecondary = roomRoutes.meta.assemblySecondary ?? '';
const exitLabels = roomRoutes.exits;
const exitLabel = exitLabels[meta.nearestExit] ?? meta.nearestExit;
const hasPoster = Boolean(overlay.rooms?.[meta.id]);
const church = roomRoutes.meta.church ?? 'Arnold Church of Christ';
const address = roomRoutes.meta.address ?? '1363 Jeffco Blvd, Arnold, MO 63010';
const floorNote = ` on level ${meta.floor}`;

const siblings = roomRoutes.rooms
	.filter((r) => r.floor === meta.floor)
	.sort(sortRoomsByFloor)
	.map((r) => ({ id: r.id, label: formatRoomLabel(r.id, r.name) }));
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow, noarchive, nosnippet, noimageindex" />
		<title>{title} — Arnold Emergency</title>
		<link rel="stylesheet" href="/room-page.css" />
	</head>
	<body class="room-page" data-room-id={meta.id}>
		<header class="room-top">
			<p class="room-kicker">Arnold Emergency · Level {meta.floor}</p>
			<h1>{title}</h1>
			<p class="room-sub">Your room card — know this exit, then open the full playbook.</p>
		</header>

		<section class="room-card room-card--actions" aria-label="Check in">
			<h2>Check in with your Alert PIN</h2>
			<p class="room-muted">
				Use the same 6-digit PIN from Arnold Alert (alarm.arnoldcoc.org). Anyone with a PIN can
				confirm they’ve reviewed this room.
			</p>
			<label class="room-label" for="alert-pin">Arnold Alert PIN</label>
			<input
				id="alert-pin"
				class="room-input"
				type="password"
				inputmode="numeric"
				pattern="[0-9]*"
				maxlength="6"
				autocomplete="one-time-code"
				placeholder="6-digit PIN"
			/>
			<button type="button" class="room-btn room-btn--primary" id="ack-btn">I’ve reviewed this room</button>
			<p class="room-status" id="ack-status" hidden></p>
		</section>

		<section class="room-card" aria-label="This room">
			<h2>This room</h2>
			<dl class="room-facts">
				<div>
					<dt>Exit path</dt>
					<dd>{meta.path}</dd>
				</div>
				<div>
					<dt>Nearest exit</dt>
					<dd>{exitLabel}</dd>
				</div>
				<div>
					<dt>Assembly</dt>
					<dd>
						<strong>{assembly}</strong>
						{assemblySecondary ? <span class="room-muted"> · Weather: lower auditorium if IC directs</span> : null}
					</dd>
				</div>
			</dl>
			{
				hasPoster ? (
					<a class="room-poster" href={`/posters/room-${meta.id}.png`} target="_blank" rel="noopener">
						<img
							src={`/posters/room-${meta.id}.png`}
							alt={`Evacuation map for ${title}`}
							width="794"
							height="1286"
							loading="eager"
							decoding="async"
						/>
						<span>Open full map</span>
					</a>
				) : null
			}
		</section>

		<section class="room-card" aria-label="Codes">
			<h2 class="code-red">Code Red — Evacuate</h2>
			<p>Leave the building now. Calm voice: <em>“We’re leaving — follow me.”</em></p>
			<p>
				<strong>Exit:</strong> {meta.path} → <strong>Assembly:</strong> {assembly}
			</p>
			<p>Take your roster. Count everyone at assembly.</p>

			<h2 class="code-blue">Code Blue — Lockdown</h2>
			<p>Lock the door, lights off, phones silent. Stay quiet. Do not leave.</p>
			<p>Do not open the door except law enforcement or verified IC.</p>

			<h2 class="code-amber">911</h2>
			<p>Call <strong>911</strong> first when life is at risk. Campus horns do not call police for you.</p>
			<div class="room-script">
				<p class="room-script-label">Say this:</p>
				<p>
					“I need help at {church}, {address}. I am in {title}
					{floorNote}. <em>[Describe what happened]</em>”
				</p>
			</div>
		</section>

		<section class="room-card" aria-label="Broader playbook">
			<h2>More on the playbook</h2>
			<ul class="room-links">
				<li><a href="/">Home — all procedures</a></li>
				<li><a href="/quick-reference/">Quick reference</a></li>
				<li><a href="/system/campus-audio/">Hear campus tones</a></li>
				<li><a href="/codes/overview/">Codes overview</a></li>
				<li><a href={`/print/door-card/${meta.id}/`}>Print door card</a></li>
				{hasPoster ? <li><a href={`/classroom/room-posters/#room-${meta.id}`}>Browse map posters</a></li> : null}
				<li><a href="/rooms/">All rooms</a></li>
			</ul>
		</section>

		{
			siblings.length > 1 ? (
				<section class="room-card" aria-label="Same floor">
					<h2>Same floor</h2>
					<ul class="room-links room-links--compact">
						{siblings
							.filter((s) => s.id !== meta.id)
							.map((s) => (
								<li>
									<a href={`/rooms/${s.id}/`}>{s.label}</a>
								</li>
							))}
					</ul>
				</section>
			) : null
		}

		<footer class="room-foot">
			<p>
				<a href="/">emergency.arnoldcoc.org</a> · Check in with your Arnold Alert PIN
			</p>
		</footer>

		<script is:inline>
			(function () {
				const roomId = document.body.getAttribute('data-room-id');
				if (!roomId) return;

				const PIN_KEY = 'ae-alert-pin';
				const status = document.getElementById('ack-status');
				const btn = document.getElementById('ack-btn');
				const pinInput = document.getElementById('alert-pin');
				const savedPin = sessionStorage.getItem(PIN_KEY);
				if (savedPin && pinInput) pinInput.value = savedPin;

				function setStatus(msg, ok) {
					if (!status) return;
					status.hidden = false;
					status.textContent = msg;
					status.className = 'room-status' + (ok ? ' room-status--ok' : '');
				}

				async function track(action, pin) {
					try {
						const res = await fetch('/api/room-track', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({ action: action, roomId: roomId, pin: pin || '' }),
						});
						const data = await res.json().catch(function () {
							return {};
						});
						return { ok: res.ok && data.ok, status: res.status, data: data };
					} catch (e) {
						return { ok: false, data: { error: 'network' } };
					}
				}

				track('view');

				btn &&
					btn.addEventListener('click', async function () {
						const pin = ((pinInput && pinInput.value) || '').replace(/\D/g, '');
						if (pin.length !== 6) {
							setStatus('Enter your 6-digit Arnold Alert PIN.', false);
							return;
						}
						btn.disabled = true;
						btn.textContent = 'Checking…';
						const result = await track('ack', pin);
						if (result.ok) {
							sessionStorage.setItem(PIN_KEY, pin);
							const label = (result.data && result.data.label) || 'You';
							setStatus(
								'Thanks, ' + label + ' — checked in. Open the playbook below for more.',
								true,
							);
							btn.textContent = 'Reviewed';
						} else {
							btn.disabled = false;
							btn.textContent = 'I’ve reviewed this room';
							setStatus(
								(result.data && result.data.error) || 'Could not check in — try again.',
								false,
							);
						}
					});
			})();
		</script>
	</body>
</html>
