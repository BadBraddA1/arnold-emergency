---
import roomRoutes from '../../../../data/room-routes.json';
import overlay from '../../../../data/room-map-overlay.json';

export function getStaticPaths() {
	return Object.keys(overlay.rooms ?? {}).map((room) => ({ params: { room } }));
}

const { room } = Astro.params;
const meta = roomRoutes.rooms.find((r) => r.id === room);
const label = meta
	? /^\d+$/.test(meta.id)
		? `Room ${meta.id} — ${meta.name}`
		: meta.name
	: room;
const src = `/posters/room-${room}.png`;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="robots" content="noindex, nofollow" />
		<title>Print — {label}</title>
		<style>
			* {
				box-sizing: border-box;
			}
			body {
				margin: 0;
				font-family: system-ui, sans-serif;
				background: #f1f5f9;
				color: #0f172a;
			}
			.toolbar {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				align-items: center;
				padding: 0.75rem 1rem;
				background: #fff;
				border-bottom: 1px solid #cbd5e1;
			}
			.toolbar a,
			.toolbar button {
				font: inherit;
				font-size: 0.95rem;
				padding: 0.45rem 0.85rem;
				border-radius: 6px;
				border: 1px solid #94a3b8;
				background: #fff;
				color: #0f172a;
				text-decoration: none;
				cursor: pointer;
			}
			.toolbar button.primary {
				background: #1e3a5f;
				border-color: #1e3a5f;
				color: #fff;
				font-weight: 600;
			}
			.frame {
				padding: 1rem;
				display: flex;
				justify-content: center;
			}
			img {
				display: block;
				max-width: min(100%, 794px);
				height: auto;
				background: #fff;
				box-shadow: 0 8px 24px rgb(15 23 42 / 12%);
			}
			@media print {
				.toolbar {
					display: none;
				}
				body {
					background: #fff;
				}
				.frame {
					padding: 0;
				}
				img {
					width: 100%;
					max-width: none;
					box-shadow: none;
				}
			}
		</style>
	</head>
	<body>
		<div class="toolbar">
			<button type="button" class="primary" onclick="window.print()">Print</button>
			<a href={src} download={`room-${room}.png`}>Download PNG</a>
			<a href="/classroom/room-posters/">All room posters</a>
		</div>
		<div class="frame">
			<img src={src} alt={`Evacuation map — ${label}`} width="794" height="1286" />
		</div>
	</body>
</html>
