---
import roomRoutes from '../../data/room-routes.json';

const { title, exit, assembly, floor, compact = false } = Astro.props as {
	title: string;
	exit: string;
	assembly: string;
	floor?: number;
	compact?: boolean;
};

const church = roomRoutes.meta.church ?? 'Arnold Church of Christ';
const address = roomRoutes.meta.address ?? '1363 Jeffco Blvd, Arnold, MO 63010';
const floorNote = floor ? ` on level ${floor}` : '';
---

<article class:list={['door-card', 'not-content', compact && 'door-card--compact']}>
	<header class="door-card-head">
		<p class="door-card-org">{church}</p>
		<h1 class="door-card-title">{title}</h1>
		<p class="door-card-tag">In-room emergency card · post near the door</p>
	</header>

	<section class="door-card-block" aria-label="Code Red">
		<h2 class="door-card-code door-card-code--red">Code Red — Evacuate</h2>
		<p>Leave the building now. Calm voice: <em>“We’re leaving — follow me.”</em></p>
		<p>
			<strong>Exit:</strong> {exit} → <strong>Assembly:</strong> {assembly}
		</p>
		<p>Take your roster. Count everyone at assembly.</p>
	</section>

	<section class="door-card-block" aria-label="Code Blue">
		<h2 class="door-card-code door-card-code--blue">Code Blue — Lockdown</h2>
		<p>Lock the door, lights off, phones silent. Stay quiet. Do not leave.</p>
		<p>Do not open the door except law enforcement or verified IC.</p>
	</section>

	<section class="door-card-block" aria-label="911">
		<h2 class="door-card-code door-card-code--amber">911</h2>
		<p>Call <strong>911</strong> first when life is at risk. Campus horns do not call police for you.</p>
		<div class="door-card-script">
			<p class="door-card-script-label">Say this:</p>
			<p class="door-card-script-text">
				“I need help at {church}, {address}. I am in {title}{floorNote}. <em>[Describe what happened — injury, fire, threat, etc.]</em>”
			</p>
		</div>
	</section>

	<footer class="door-card-foot">
		<p>Arnold Alert: alarm.arnoldcoc.org · Playbook: emergency.arnoldcoc.org</p>
	</footer>
</article>

<style>
	.door-card {
		max-width: 28rem;
		margin: 0 auto;
		padding: 1.15rem 1.2rem 1.05rem;
		border: 2px solid #1e293b;
		border-radius: 0.5rem;
		background: #fff;
		color: #0f172a;
		font-family: 'DM Sans', system-ui, sans-serif;
		font-size: 1rem;
		line-height: 1.55;
	}

	.door-card--compact {
		max-width: none;
		margin: 0;
	}

	.door-card-head {
		margin-bottom: 0.85rem;
		padding-bottom: 0.65rem;
		border-bottom: 1px solid #cbd5e1;
	}

	.door-card-org {
		margin: 0;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.06em;
		color: #475569;
	}

	.door-card-title {
		margin: 0.2rem 0 0;
		font-family: 'Source Serif 4', Georgia, serif;
		font-size: 1.4rem;
		line-height: 1.25;
		color: #0f172a;
	}

	.door-card-tag {
		margin: 0.35rem 0 0;
		font-size: 0.82rem;
		color: #475569;
	}

	.door-card-block {
		margin: 0 0 0.9rem;
	}

	.door-card-block p,
	.door-card-block strong,
	.door-card-block em {
		color: #1e293b;
	}

	.door-card-code {
		margin: 0 0 0.4rem;
		font-size: 1.05rem;
		line-height: 1.3;
		font-weight: 700;
	}

	.door-card-code--red {
		color: #b91c1c;
	}

	.door-card-code--blue {
		color: #1d4ed8;
	}

	.door-card-code--amber {
		color: #b45309;
	}

	.door-card-block p {
		margin: 0 0 0.35rem;
	}

	.door-card-block p:last-child {
		margin-bottom: 0;
	}

	.door-card-script {
		margin-top: 0.55rem;
		padding: 0.65rem 0.75rem;
		border: 1px dashed #94a3b8;
		border-radius: 0.35rem;
		background: #f8fafc;
	}

	.door-card-script-label {
		margin: 0 0 0.3rem;
		font-size: 0.72rem;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		color: #64748b;
	}

	.door-card-script-text {
		margin: 0;
		font-size: 0.95rem;
		line-height: 1.55;
		color: #0f172a;
	}

	.door-card-script-text em {
		color: #475569;
		font-style: italic;
	}

	.door-card-foot {
		margin-top: 0.5rem;
		padding-top: 0.55rem;
		border-top: 1px solid #e2e8f0;
		font-size: 0.8rem;
		color: #475569;
	}

	.door-card-foot p {
		margin: 0;
	}
</style>
