---
import type { EmergencyIconId } from './icons/registry';
import { iconToSymbol, parseMaterialSvg, symbolSvg } from './icons/symbols';

interface Props {
	name: EmergencyIconId;
	label?: string;
	size?: string;
	class?: string;
}

const { name, label, size = '1.25em', class: className } = Astro.props;
const a11y = label ? { 'aria-label': label } : { 'aria-hidden': 'true' };

const symbol = iconToSymbol[name];
const raw = symbolSvg[symbol];
const { viewBox, inner } = parseMaterialSvg(raw);
---

<svg
	{...a11y}
	class:list={['ae-icon', className]}
	viewBox={viewBox}
	fill="currentColor"
	set:html={inner}
/>

<style define:vars={{ 'ae-icon-size': size }}>
	.ae-icon {
		display: block;
		width: var(--ae-icon-size);
		height: var(--ae-icon-size);
		flex: none;
	}
</style>
