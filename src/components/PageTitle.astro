---
import DefaultPageTitle from '@astrojs/starlight/components/PageTitle.astro';
import EmergencyIcon from './EmergencyIcon.astro';
import { iconForPath } from './icons/registry';

const icon = iconForPath(Astro.url.pathname);
---

<div class:list={['page-title-wrap', icon && `page-title-wrap--${icon}`]}>
	{icon ? (
		<span class="page-title-icon" aria-hidden="true">
			<EmergencyIcon name={icon} size="1.65em" />
		</span>
	) : null}
	<DefaultPageTitle {...Astro.props}>
		<slot />
	</DefaultPageTitle>
</div>
