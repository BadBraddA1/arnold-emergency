---
import roomRoutes from '../../data/room-routes.json';
import overlay from '../../data/room-map-overlay.json';
import DoorCardPreview from './DoorCardPreview.astro';
import { formatRoomLabel, sortRoomsByFloor } from '../lib/rooms.mjs';

const assembly = roomRoutes.meta.assemblyDefault ?? 'South parking lot';
const overlayIds = new Set(Object.keys(overlay.rooms ?? {}));

const rows = roomRoutes.rooms
	.map((room) => ({
		id: room.id,
		floor: room.floor,
		label: formatRoomLabel(room.id, room.name),
		exit: room.path,
		hasPoster: overlayIds.has(room.id),
		printHref: `/print/door-card/${room.id}/`,
	}))
	.sort(sortRoomsByFloor);

const byFloor = [1, 2].map((floor) => ({
	floor,
	rooms: rows.filter((r) => r.floor === floor),
}));
---

<p class="door-gallery-intro">
	Text checklist for the door frame — Code Red, Code Blue, and 911 only. Same exit notes as the map data.
	<strong>Assembly:</strong> {assembly}
</p>

{
	byFloor.map(({ floor, rooms }) =>
		rooms.length ? (
			<section class="door-gallery-floor" aria-labelledby={`door-floor-${floor}`}>
				<h2 id={`door-floor-${floor}`}>Level {floor}</h2>
				<ul class="door-gallery-list">
					{rooms.map((room) => (
						<li class="door-gallery-item" id={`door-${room.id}`}>
							<div class="door-gallery-item-head">
								<h3>{room.label}</h3>
								<div class="door-gallery-actions">
									<a class="ae-btn ae-btn--primary" href={room.printHref}>
										Print
									</a>
									{room.hasPoster ? (
										<a class="ae-btn" href={`/classroom/room-posters/#room-${room.id}`}>
											Map poster
										</a>
									) : null}
								</div>
							</div>
							<details class="door-gallery-preview">
								<summary>Preview card</summary>
								<DoorCardPreview
									title={room.label}
									exit={room.exit}
									assembly={assembly}
									floor={room.floor}
									roomId={room.id}
									compact
								/>
							</details>
						</li>
					))}
				</ul>
			</section>
		) : null,
	)
}
